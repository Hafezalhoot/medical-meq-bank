{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medical-meq-bank.local/schemas/lecture.schema.json",
  "title": "Medical MEQ Lecture Payload v1",
  "type": "object",
  "required": [
    "id",
    "order",
    "subjectKey",
    "subject",
    "title",
    "subtopics",
    "cases",
    "coreShorts",
    "imageQuestions",
    "detailedShorts",
    "rapid"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "courseId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "canonicalId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*/[^/]+$"
    },
    "id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "order": {
      "type": "number"
    },
    "subjectKey": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "subject": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "title": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "subtitle": {
      "type": "string"
    },
    "sourceNote": {
      "type": "string"
    },
    "subtopics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/subtopic"
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "coreShorts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shortQuestion"
      }
    },
    "imageQuestions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/imageQuestion"
      }
    },
    "detailedShorts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shortQuestion"
      }
    },
    "rapid": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rapid"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "subtopic": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "sharedStudyFields": {
      "type": "object",
      "required": [
        "id",
        "topic",
        "priority",
        "marks",
        "subtopics"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "topic": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "priority": {
          "enum": [
            "High",
            "Core"
          ]
        },
        "marks": {
          "type": "number",
          "minimum": 0
        },
        "subtopics": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "case": {
      "allOf": [
        {
          "$ref": "#/$defs/sharedStudyFields"
        },
        {
          "type": "object",
          "required": [
            "title",
            "questions",
            "answer"
          ],
          "properties": {
            "title": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "questions": {
              "$ref": "#/$defs/stringList"
            },
            "answer": {
              "$ref": "#/$defs/stringList"
            },
            "scenario": {
              "type": "string"
            },
            "ar": {
              "type": "string"
            },
            "marking": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              }
            },
            "trap": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "answer": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "$ref": "#/$defs/stringList"
        }
      ]
    },
    "shortQuestion": {
      "allOf": [
        {
          "$ref": "#/$defs/sharedStudyFields"
        },
        {
          "type": "object",
          "required": [
            "q",
            "a"
          ],
          "properties": {
            "q": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "a": {
              "$ref": "#/$defs/answer"
            },
            "section": {
              "type": "string"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "imageQuestion": {
      "allOf": [
        {
          "$ref": "#/$defs/sharedStudyFields"
        },
        {
          "type": "object",
          "required": [
            "title",
            "questions",
            "answer"
          ],
          "properties": {
            "title": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "questions": {
              "$ref": "#/$defs/stringList"
            },
            "answer": {
              "$ref": "#/$defs/stringList"
            },
            "prompt": {
              "type": "string"
            },
            "image": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "page": {
              "oneOf": [
                {
                  "$ref": "#/$defs/nonEmptyString"
                },
                {
                  "type": "number"
                }
              ]
            },
            "imageBytes": {
              "type": "integer",
              "minimum": 1
            },
            "imageSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "anyOf": [
            {
              "required": [
                "image"
              ]
            },
            {
              "required": [
                "page"
              ]
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "rapid": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "$ref": "#/$defs/nonEmptyString"
        }
      ],
      "items": false
    }
  },
  "additionalProperties": false
}
