{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medical-meq-bank.local/schemas/course-pack.schema.json",
  "title": "Medical MEQ Course Pack",
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "id",
    "label",
    "order",
    "defaultSubject",
    "subjects"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "order": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "defaultSubject": {
      "type": "string",
      "minLength": 1
    },
    "lectureCatalog": {
      "type": "string",
      "minLength": 1
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "order"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "schemaVersion": {
      "const": 2
    }
  },
  "additionalProperties": false
}
